{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Mongo": {
    "Database": "MUGVN-Hackathon",
    "Collection": "SmartFarm"
  },
  "Farm": {
    "Id": "farm-001",
    "SeedDevices": true
  },
  "Redis": {
    "ChannelPrefix": "smartfarm",
    "PublishTimeoutMs": 1500
  },
  "Keycloak": {
    "Audience": "smartfarm-api",
    "BrowserClientId": "smartfarm-demo",
    "AdminRole": "farm-admin"
  }
}
