<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>MUGVN_SmartFarm</RootNamespace>
        <UserSecretsId>smartfarm-api-development</UserSecretsId>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <DefaultItemExcludes>$(DefaultItemExcludes);Shared/**;Contracts/**;Infrastructure/**;Ingestion/**;Tests/**;UI/**;datadog/**;node_modules/**</DefaultItemExcludes>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FastEndpoints" Version="8.3.0" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
        <PackageReference Include="MongoDB.Driver" Version="3.13.0" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
        <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Api\" />
      <Folder Include="Application\" />
    </ItemGroup>

    <ItemGroup><ProjectReference Include="Contracts/SmartFarm.Contracts.csproj" /><ProjectReference Include="Infrastructure/SmartFarm.Infrastructure.csproj" /></ItemGroup>
</Project>
